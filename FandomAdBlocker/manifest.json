{
    "manifest_version": 3,
    "name": "FADBlock — block ads across the fandoms",
    "version": "3.0.0",
    "description": "Block pop-ups and intrusive ads across Fandom with FADBlock",
    "action": {
        "default_popup": "popup/index.html"
    },
    "permissions": [
      "storage"
    ],
    "background": {
      "service_worker": "js/background/main.js"
    },
    "content_scripts": [
        {
          "matches": ["*://*.fandom.com/*"],
          "js": [
            "js/shared/functions.js",
            "js/shared/optionsMap.js",
            "js/website/globalVariables.js",
            "js/website/statistics.js",
            "js/website/allowedList.js",
            "js/website/main.js",
            "js/website/reload.js"
          ]
        }
      ],
     "icons": {
        "16": "img/16.png",
        "32": "img/32.png",
        "48": "img/48.png",
        "64": "img/64.png",
        "96": "img/96.png",
        "128": "img/128.png"
     }
}